    ],
    onl:{create:'방 만들기',join:'참가',code:'방 코드',link:'초대 링크',copy:'복사',waiting:'상대를 기다리는 중…',connecting:'연결 중…',
      connected:'연결됨',youAre:c=>`당신은 ${c===1?'흑(선공)':'백(후공)'}`,closed:'연결이 끊겼다.',
      loadFail:'온라인 모듈을 불러오지 못했습니다. 인터넷 연결이 필요합니다.',
      peerErr:'연결 실패: ',fileNote:'파일을 직접 열었으면 링크 대신 방 코드를 알려줘야 합니다.',
      oppNew:'상대가 새 게임을 시작했습니다.'}
  },
  en:{
    tagline:'Place a stone, and the nearest stones slide in. Build the biggest group.',
    opponent:'Opponent',vsAI:'AI',local:'Two players',online:'Online',
    level:'Level',easy:'Easy',normal:'Normal',hard:'Hard',impossible:'Impossible',
    playAs:'Play as',blackFirst:'Black (first)',whiteSecond:'White',newGame:'New game',undo:'Undo',shareLink:'Copy link to continue',copied:'Copied',
    black:'Black',white:'White',toMove:'to move',you:'(you)',ai:'(AI)',thinking:'(AI thinking…)',remote:'(opponent)',
    placed:'Stones placed',largest:'Largest group',groups:'groups',
    wins:'wins',decidedBy:i=>i===0?'largest group':`${i+1}${['st','nd','rd'][i]||'th'} group`,fullTie:'complete tie → second player wins',
    emptyMoves:'Moves will appear here.',
    hintHover:'Hover an empty cell to preview which stones get pulled.',
    hintTouch:'Tap an empty cell to preview, tap again to place.',
    aiLine:(lv,r)=>`AI (${lv}) — ${r.iters.toLocaleString()} simulations, est. win ${Math.round(r.winrate*100)}%, ${(r.ms/1000).toFixed(1)}s`,
    corrLoaded:'Loaded from a link. Make a move and send the new link back.',
    rulesTitle:'Rules',
    rules:[
      '9×9 Torus board. Players alternate placing one stone on any empty cell. Black moves first.',
      '⭐ The board wraps around! The top connects to the bottom, and left to right. There are no edges, corners, or center.',
      'The placed stone has gravity: in each orthogonal direction (including wrapped paths), the nearest stone slides across empty cells until it touches the new stone.',
      'The game ends when 80 stones have been placed (one empty cell left).',
      'Compare each player\'s largest orthogonally connected group (connections wrap around!). Bigger wins.',
      'If the largest groups are equal, compare the second largest, then third... A complete tie goes to White (second player).'
    ],
    onl:{create:'Create room',join:'Join',code:'Room code',link:'Invite link',copy:'Copy',waiting:'Waiting for opponent…',connecting:'Connecting…',
      connected:'Connected',youAre:c=>`You are ${c===1?'Black (first)':'White (second)'}`,closed:'Connection lost.',
      loadFail:'Could not load the online module. It needs internet access.',
      peerErr:'Connection failed: ',fileNote:'If local file, share room code instead of link.',
      oppNew:'Your opponent started a new game.'}
  }
};
const $=id=>document.getElementById(id);
let lang=(navigator.language||'en').toLowerCase().startsWith('ko')?'ko':'en';
const T=()=>I18N[lang];
const HOVER=window.matchMedia&&window.matchMedia('(hover: hover)').matches;

let game=newGame();
let mode='ai',level='normal',humanColor=BLACK;
let selected=-1,thinking=false,aiInfo=null,corrMode=false;
let online={peer:null,conn:null,role:null,connected:false,myColor:BLACK,msg:''};
const stoneEls=new Map();

function colorName(c){return c===BLACK?T().black:T().white;}
function myTurn(){
  if(game.result||thinking)return false;
  if(mode==='ai')return game.toMove===humanColor;
  if(mode==='online')return online.connected&&game.toMove===online.myColor;
  return true;
}
function applyStrings(){
  document.documentElement.lang=lang;
  document.querySelectorAll('[data-t]').forEach(el=>{el.textContent=T()[el.dataset.t];});
  document.querySelectorAll('[data-to]').forEach(el=>{el.textContent=T().onl[el.dataset.to];});
  $('rulesList').innerHTML=T().rules.map(r=>`<li>${r}</li>`).join('');
  $('hint').textContent=HOVER?T().hintHover:T().hintTouch;
}

/* ---------- board ---------- */
function buildGrid(){
  const grid=$('grid');grid.innerHTML='';
  for(let cell=0;cell<CELLS;cell++){
    const d=document.createElement('div');d.className='cell';d.dataset.cell=cell;
    d.addEventListener('click',()=>onCell(cell));
    if(HOVER){d.addEventListener('mouseenter',()=>{if(selected<0&&myTurn()&&game.board[cell]===0)showPreview(cell);});
      d.addEventListener('mouseleave',()=>{if(selected<0)clearPreview();});}
    grid.appendChild(d);
  }
}
const pos=cell=>({left:(cell%N)*100/N+'%',top:((cell/N)|0)*100/N+'%'});
function syncStones(){
  const layer=$('stones');const live=new Set();
  const labB=new Int8Array(CELLS),labW=new Int8Array(CELLS);
  const gb=groupSizes(game.board,BLACK,labB),gw=groupSizes(game.board,WHITE,labW);
  const sizeOf=(lab)=>{const m={};for(let i=0;i<CELLS;i++)if(lab[i])m[lab[i]]=(m[lab[i]]||0)+1;return m;};
  const sb=sizeOf(labB),sw=sizeOf(labW);
  for(const s of game.stones){
    live.add(s.id);let el=stoneEls.get(s.id);
    if(!el){el=document.createElement('div');el.className='stone '+(s.color===BLACK?'black':'white')+' new';el.innerHTML='<div class="disc"></div>';
      const p=pos(s.cell);el.style.left=p.left;el.style.top=p.top;layer.appendChild(el);stoneEls.set(s.id,el);
      requestAnimationFrame(()=>requestAnimationFrame(()=>el.classList.remove('new')));}
    else{const p=pos(s.cell);if(el.style.left!==p.left||el.style.top!==p.top){el.style.left=p.left;el.style.top=p.top;}}
    const lab=s.color===BLACK?labB[s.cell]:labW[s.cell];const sizes=s.color===BLACK?sb:sw;const max=s.color===BLACK?(gb[0]||0):(gw[0]||0);
    el.classList.toggle('top',lab&&sizes[lab]===max&&max>1);
    el.classList.remove('will-move');
  }
  for(const [id,el] of stoneEls){if(!live.has(id)){el.remove();stoneEls.delete(id);}}
  document.querySelectorAll('.cell').forEach(c=>{const cell=+c.dataset.cell;c.classList.toggle('empty',game.board[cell]===0&&!game.result);});
  $('board').classList.toggle('over',!!game.result);
  return{gb,gw};
}
function showPreview(cell){
  clearPreview();
  const pulls=pullsFor(game.board,cell);const layer=$('ghosts');
  const g=document.createElement('div');g.className='ghost '+(game.toMove===BLACK?'black':'white')+' place';const p=pos(cell);g.style.left=p.left;g.style.top=p.top;g.innerHTML='<div class="disc"></div>';layer.appendChild(g);
  for(const pl of pulls){
    const st=game.stones.find(s=>s.cell===pl.from);if(!st)continue;
    const el=stoneEls.get(st.id);if(el)el.classList.add('will-move');
    const gh=document.createElement('div');gh.className='ghost '+(st.color===BLACK?'black':'white');const q=pos(pl.to);gh.style.left=q.left;gh.style.top=q.top;gh.innerHTML='<div class="disc"></div>';layer.appendChild(gh);
  }
}
function clearPreview(){$('ghosts').innerHTML='';stoneEls.forEach(el=>el.classList.remove('will-move'));}

function onCell(cell){
  if(!myTurn()||game.board[cell]!==0)return;
  if(HOVER){selected=-1;commit(cell);return;}
  if(selected===cell){selected=-1;commit(cell);return;}
  selected=cell;showPreview(cell);
}
function commit(cell,fromRemote){
  clearPreview();selected=-1;
  playMove(game,cell);
  if(mode==='online'&&!fromRemote&&online.conn)online.conn.send({t:'move',cell,ply:game.plies});
  render();
  maybeAI();
}
function maybeAI(){
  if(mode!=='ai'||game.result||game.toMove===humanColor||thinking)return;
  thinking=true;aiInfo=null;renderPanel();
  setTimeout(()=>{
    const r=mctsChoose(game.board,game.plies,game.toMove,LEVELS[level]);
    thinking=false;aiInfo={level,r};
    playMove(game,r.move);render();
  },80);
}

/* ---------- panel ---------- */
function render(){const g=syncStones();renderPanel(g);}
function renderPanel(g){
  const t=T();if(!g){g={gb:groupSizes(game.board,BLACK),gw:groupSizes(game.board,WHITE)};}
  const tb=$('turnBox');
  if(game.result){
    const r=game.result;const a=r.black,b=r.white;let i=0;while(i<Math.max(a.length,b.length)&&(a[i]||0)===(b[i]||0))i++;
    const detail=i<Math.max(a.length,b.length)?`${t.decidedBy(i)} ${a[i]||0} : ${b[i]||0}`:t.fullTie;
    tb.innerHTML=`<div class="result"><span class="dot ${r.winner===BLACK?'b':'w'}"></span>${colorName(r.winner)} ${t.wins}<small>${detail}</small></div>`;
  }else{
    let who='';
    if(mode==='ai')who=' '+(game.toMove===humanColor?t.you:thinking?t.thinking:t.ai);
    if(mode==='online'&&online.connected)who=' '+(game.toMove===online.myColor?t.you:t.remote);
    tb.innerHTML=`<div class="turn"><span class="dot ${game.toMove===BLACK?'b':'w'}"></span>${colorName(game.toMove)} ${t.toMove}${who}</div>`;
  }
  $('placed').textContent=`${t.placed} ${game.plies} / ${MAX_PLIES}`;
  const bar=(sizes,cls)=>{const max=sizes[0]||0;return `<div class="grow"><span class="lbl"><span class="dot ${cls}"></span>${t.largest}</span><div class="bar"><div class="fill ${cls}" style="width:${max/81*100}%"></div></div><b>${max}</b><span class="rest">${sizes.slice(1,6).join(' · ')}</span></div>`;};
  $('groups').innerHTML=bar(g.gb,'b')+bar(g.gw,'w');
  const mv=$('moves');
  if(!game.moves.length)mv.innerHTML=`<div class="empty">${t.emptyMoves}</div>`;
  else{let html='<table>';for(let i=0;i<game.moves.length;i+=2){const a=game.moves[i],b=game.moves[i+1];html+=`<tr><td class="n">${i/2+1}.</td><td>${nota(a)}</td><td>${b?nota(b):''}</td></tr>`;}mv.innerHTML=html+'</table>';mv.scrollTop=mv.scrollHeight;}
  $('undoBtn').disabled=thinking||game.moves.length===0||mode==='online';
  $('shareBtn').style.display=mode==='local'?'':'none';
  $('levelRow').style.display=mode==='ai'?'':'none';
  $('colorRow').style.display=mode==='ai'?'':'none';
  $('onlineBox').style.display=mode==='online'?'':'none';
  $('aiLine').textContent=aiInfo?t.aiLine(t[aiInfo.level],aiInfo.r):(corrMode&&mode==='local'?t.corrLoaded:'');
  $('onlMsg').textContent=online.msg;
}
const cellName=c=>'abcdefghi'[c%N]+(((c/N)|0)+1);
function nota(m){return cellName(m.cell)+(m.pulls.length?'<span class="pull">×'+m.pulls.length+'</span>':'');}

/* ---------- game control ---------- */
function startGame(opts={}){
  game=newGame();selected=-1;thinking=false;aiInfo=null;corrMode=false;
  stoneEls.forEach(el=>el.remove());stoneEls.clear();clearPreview();
  if(mode==='online'&&online.conn&&online.connected&&!opts.fromRemote)online.conn.send({t:'new'});
  render();maybeAI();
}
function undo(){
  if(thinking||mode==='online')return;
  undoMove(game);
  if(mode==='ai'&&game.toMove!==humanColor&&game.moves.length)undoMove(game);
  selected=-1;aiInfo=null;clearPreview();render();
}
function shareCorrLink(){
  const url=location.href.split('#')[0]+'#m='+encodeMoves(game.moves);
  copyText(url,$('shareBtn'),T().shareLink);
}
function copyText(text,btn,label){
  const done=()=>{if(btn){btn.textContent=T().copied;setTimeout(()=>btn.textContent=label,1500);}};
  if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(text).then(done,()=>window.prompt('',text));
  else window.prompt('',text);
}
function loadFromHash(){
  const h=location.hash||'';
  const m=h.match(/#m=([a-z0-9]*)/i);
  if(m){const cells=decodeMoves(m[1]);if(cells){mode='local';setSeg('modeSeg','local');game=newGame();for(const c of cells){if(game.result||game.board[c]!==0)break;playMove(game,c);}corrMode=true;render();return true;}}
  const j=h.match(/#join=([A-Za-z0-9]+)/);
  if(j){mode='online';setSeg('modeSeg','online');render();joinRoom(j[1]);return true;}
  return false;
}

/* ---------- online (PeerJS) ---------- */
function loadScript(src){return new Promise((res,rej)=>{const s=document.createElement('script');s.src=src;s.onload=res;s.onerror=rej;document.head.appendChild(s);});}
async function ensurePeer(){
  if(window.Peer)return true;
  const urls=['https://cdnjs.cloudflare.com/ajax/libs/peerjs/1.5.4/peerjs.min.js','https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js'];
  for(const u of urls){try{await loadScript(u);if(window.Peer)return true;}catch(e){}}
  return false;
}
const roomCode=()=>{const a='ABCDEFGHJKLMNPQRSTUVWXYZ23456789';let s='';for(let i=0;i<6;i++)s+=a[(Math.random()*a.length)|0];return s;};
function setOnlMsg(m){online.msg=m;renderPanel();}
function teardownPeer(){try{if(online.conn)online.conn.close();if(online.peer)online.peer.destroy();}catch(e){}online.conn=null;online.peer=null;online.connected=false;online.role=null;}
async function hostRoom(){
  teardownPeer();setOnlMsg(T().onl.connecting);
  if(!await ensurePeer()){setOnlMsg(T().onl.loadFail);return;}
  const code=roomCode();const peer=new Peer('gravity-'+code);online.peer=peer;online.role='host';online.myColor=BLACK;
  peer.on('open',()=>{
    const link=location.href.split('#')[0]+'#join='+code;
    $('roomCode').textContent=code;$('roomLink').value=link;$('roomInfo').style.display='';
    setOnlMsg(T().onl.waiting+(location.protocol==='file:'?' '+T().onl.fileNote:''));
  });
  peer.on('connection',c=>{if(online.conn){c.close();return;}online.conn=c;wireConn(c);});
  peer.on('error',e=>setOnlMsg(T().onl.peerErr+(e.type||e)));
}
async function joinRoom(code){
  teardownPeer();setOnlMsg(T().onl.connecting);
  if(!await ensurePeer()){setOnlMsg(T().onl.loadFail);return;}
  const peer=new Peer();online.peer=peer;online.role='guest';online.myColor=WHITE;
  peer.on('open',()=>{const c=peer.connect('gravity-'+code.toUpperCase(),{reliable:true});online.conn=c;wireConn(c);});
  peer.on('error',e=>setOnlMsg(T().onl.peerErr+(e.type||e)));
}
function wireConn(c){
  c.on('open',()=>{online.connected=true;$('roomInfo').style.display=online.role==='host'?'':'none';
    setOnlMsg(T().onl.connected+' — '+T().onl.youAre(online.myColor));game=newGame();stoneEls.forEach(el=>el.remove());stoneEls.clear();render();});
  c.on('data',msg=>{
    if(!msg||typeof msg!=='object')return;
    if(msg.t==='move'){if(game.result||game.toMove===online.myColor||game.board[msg.cell]!==0||msg.ply!==game.plies+1)return;commit(msg.cell,true);}
    else if(msg.t==='new'){startGame({fromRemote:true});setOnlMsg(T().onl.oppNew+' — '+T().onl.youAre(online.myColor));}
  });
  c.on('close',()=>{online.connected=false;setOnlMsg(T().onl.closed);});
  c.on('error',e=>setOnlMsg(T().onl.peerErr+e));
}

/* ---------- controls ---------- */
function seg(id,onPick){const el=$(id);el.querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>{setSeg(id,b.dataset.v);onPick(b.dataset.v);}));}
function setSeg(id,v){$(id).querySelectorAll('button').forEach(x=>x.classList.toggle('on',x.dataset.v===v));}
seg('langSeg',v=>{lang=v;applyStrings();render();});
seg('modeSeg',v=>{if(mode==='online'&&v!=='online')teardownPeer();mode=v;online.msg='';$('roomInfo').style.display='none';startGame();});
seg('levelSeg',v=>{level=v;renderPanel();});
seg('colorSeg',v=>{humanColor=Number(v);startGame();});
$('newBtn').addEventListener('click',()=>startGame());
$('undoBtn').addEventListener('click',undo);
$('shareBtn').addEventListener('click',shareCorrLink);
$('createBtn').addEventListener('click',hostRoom);
$('joinBtn').addEventListener('click',()=>{const c=$('joinCode').value.trim();if(c)joinRoom(c);});
$('copyLinkBtn').addEventListener('click',()=>copyText($('roomLink').value,$('copyLinkBtn'),T().onl.copy));
setSeg('langSeg',lang);
applyStrings();buildGrid();
if(!loadFromHash())startGame();

</script>
