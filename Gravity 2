<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Gravity · 중력 (9x9 Torus)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;600;700&family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#14232A; --panel:#1C3038; --panel-2:#22383F;
    --text:#E9E4DA; --muted:#98A5A2;
    --board:#2A3F47; --line:rgba(233,228,218,.10);
    --stone-b:#171717; --stone-w:#ECE6DA;
    --amber:#E3B04B; --amber-dim:rgba(227,176,75,.55);
  }
  *{box-sizing:border-box}
  html,body{margin:0;background:var(--bg);color:var(--text);
    font-family:"Noto Serif KR","Cormorant Garamond",Georgia,serif;font-size:16px;line-height:1.6}
  button,input{font:inherit;color:inherit}
  button{cursor:pointer}
  button:focus-visible,input:focus-visible{outline:2px solid var(--amber);outline-offset:2px}

  .app{max-width:1120px;margin:0 auto;padding:20px 18px 40px;display:grid;grid-template-columns:1fr;gap:22px}
  @media(min-width:900px){.app{grid-template-columns:minmax(0,600px) minmax(300px,1fr);align-items:start;padding-top:32px}}

  .board-col{display:flex;flex-direction:column;align-items:center;gap:10px}
  .board{position:relative;width:min(92vw,600px);aspect-ratio:1;background:var(--board);border-radius:10px;
    box-shadow:0 14px 40px rgba(0,0,0,.5), inset 0 0 0 1px rgba(233,228,218,.08);overflow:hidden}
  /* 9x9 Grid */
  .grid{position:absolute;inset:0;display:grid;grid-template-columns:repeat(9,1fr);grid-template-rows:repeat(9,1fr)}
  .cell{border:1px solid var(--line);position:relative}
  .cell.empty{cursor:pointer}
  .cell.empty:hover{background:rgba(233,228,218,.04)}
  .board.over .cell{cursor:default}
  .layer{position:absolute;inset:0;pointer-events:none}
  /* 100% / 9 = 11.1111% */
  .stone,.ghost{position:absolute;width:11.1111%;height:11.1111%;display:flex;align-items:center;justify-content:center;
    transition:left .38s cubic-bezier(.2,.8,.2,1), top .38s cubic-bezier(.2,.8,.2,1), opacity .2s}
  .disc{width:78%;height:78%;border-radius:50%;box-shadow:0 3px 6px rgba(0,0,0,.45), inset 0 -4px 0 rgba(0,0,0,.18);transition:box-shadow .2s,transform .2s,opacity .2s}
  .stone.black .disc{background:radial-gradient(circle at 35% 30%,#3a3a3a,var(--stone-b) 60%)}
  .stone.white .disc{background:radial-gradient(circle at 35% 30%,#fff,var(--stone-w) 65%)}
  .stone.new .disc{transform:scale(.3);opacity:0}
  .stone.top .disc{box-shadow:0 0 0 2.5px var(--amber),0 3px 6px rgba(0,0,0,.45), inset 0 -4px 0 rgba(0,0,0,.18)}
  .stone.will-move .disc{opacity:.45;transform:scale(.92)}
  .board.over .stone:not(.top) .disc{opacity:.35}
  .ghost .disc{opacity:.55;box-shadow:0 0 0 2px var(--amber-dim)}
  .ghost.black .disc{background:var(--stone-b)} .ghost.white .disc{background:var(--stone-w)}
  .ghost.place .disc{opacity:.7;box-shadow:0 0 0 2.5px var(--amber)}
  @media(prefers-reduced-motion:reduce){.stone,.ghost,.disc{transition:none}}
  .hint,.ai-line{font-size:13px;color:var(--muted);min-height:1.5em;text-align:center}

  .panel{display:flex;flex-direction:column;gap:16px}
  .head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
  .title{margin:0;font-family:"Cormorant Garamond",Georgia,serif;font-size:46px;font-weight:700;letter-spacing:.03em;line-height:1}
  .title small{font-family:"Noto Serif KR",serif;font-size:18px;font-weight:400;color:var(--muted);margin-left:10px;letter-spacing:0}
  .tagline{margin:4px 0 0;color:var(--muted);font-size:14px}
  .controls{display:flex;flex-direction:column;gap:10px}
  .row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
  .row .lbl{width:64px;color:var(--muted);font-size:14px}
  .seg{display:inline-flex;border:1px solid rgba(233,228,218,.35);border-radius:6px;overflow:hidden}
  .seg button{background:transparent;border:0;padding:6px 14px;font-size:14px;color:var(--text)}
  .seg button+button{border-left:1px solid rgba(233,228,218,.2)}
  .seg button.on{background:var(--text);color:var(--bg);font-weight:600}
  .seg.small button{padding:3px 10px;font-size:13px}
  .actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:2px}
  .btn{border:1px solid rgba(233,228,218,.45);background:transparent;border-radius:6px;padding:7px 16px;font-size:15px}
  .btn.primary{background:var(--amber);color:var(--bg);border-color:var(--amber);font-weight:600}
  .btn:disabled{opacity:.4;cursor:default}

  .status{background:var(--panel);border-radius:8px;padding:14px 16px;display:flex;flex-direction:column;gap:10px}
  .turn{display:flex;align-items:center;gap:10px;font-size:18px;font-weight:600}
  .dot{width:16px;height:16px;border-radius:50%;display:inline-block;flex:none;box-shadow:inset 0 -2px 0 rgba(0,0,0,.2)}
  .dot.b{background:var(--stone-b);border:1px solid #444} .dot.w{background:var(--stone-w)}
  .result{font-size:18px;font-weight:700;color:var(--amber);display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .result small{display:block;width:100%;font-weight:400;color:var(--text);font-size:14px}
  .placed{font-size:14px;color:var(--muted)}
  .grow{display:grid;grid-template-columns:auto 1fr auto auto;align-items:center;gap:10px;font-size:14px}
  .grow .lbl{display:flex;align-items:center;gap:6px;color:var(--muted);width:120px}
  .grow .lbl .dot{width:12px;height:12px}
  .grow .bar{height:8px;background:rgba(0,0,0,.35);border-radius:4px;overflow:hidden}
  .grow .fill{height:100%;transition:width .3s}
  .grow .fill.b{background:#6b6b6b} .grow .fill.w{background:var(--stone-w)}
  .grow b{width:28px;text-align:right}
  .grow .rest{color:var(--muted);font-size:12px;width:70px}

  .online{background:var(--panel-2);border-radius:8px;padding:12px 14px;display:flex;flex-direction:column;gap:10px;font-size:14px}
  .online .row .lbl{width:auto}
  .online input{background:rgba(0,0,0,.3);border:1px solid rgba(233,228,218,.25);border-radius:6px;padding:6px 10px;font-size:14px;min-width:0}
  .online input.link{flex:1}
  .online .code{font-family:"Cormorant Garamond",Georgia,serif;font-size:26px;letter-spacing:.15em;font-weight:700;color:var(--amber)}
  .online .msg{color:var(--muted);min-height:1.5em}

  .moves{background:var(--panel);border-radius:8px;padding:10px 14px;max-height:180px;overflow:auto;font-size:14px}
  .moves table{border-collapse:collapse;width:100%}
  .moves td{padding:2px 6px;vertical-align:top}
  .moves td.n{color:var(--muted);width:32px;text-align:right}
  .moves .pull{color:var(--amber);font-size:12px;margin-left:3px}
  .moves .empty{color:var(--muted)}
  details{font-size:14px;color:var(--muted)}
  details summary{cursor:pointer;color:var(--text)}
  details ul{padding-left:18px;margin:8px 0 0}
  details li{margin:3px 0}
</style>
</head>
<body>
