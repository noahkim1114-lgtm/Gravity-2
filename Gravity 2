    <div class="moves" id="moves"></div>

    <details>
      <summary data-t="rulesTitle"></summary>
      <ul id="rulesList"></ul>
    </details>
  </div>
</div>

<script id="engine">
/* =====================================================================
   Gravity — engine: board, pull physics, scoring, MCTS AI
   ===================================================================== */
const N=9,CELLS=81,MAX_PLIES=80; // 9x9 Torus. 80칸을 놓으면(1칸 남으면) 끝.
const BLACK=1,WHITE=2;
const ADJ=[];const RAYS=[]; 
const wrap = (x) => ((x % N) + N) % N; // 음수를 안전하게 순환시키는 모듈로 함수

(function(){
  const DIRS=[[-1,0],[1,0],[0,-1],[0,1]];
  for(let cell=0;cell<CELLS;cell++){
    const r=(cell/N)|0,c=cell%N;const adj=[],rays=[];
    for(const [dr,dc] of DIRS){
      // 바로 옆 칸 (Torus 순환 적용)
      adj.push(wrap(r+dr)*N + wrap(c+dc));
      
      const ray=[];
      // 9x9의 최대 최단 거리는 4입니다. (5부터는 반대쪽에서 더 가깝게 측정됨)
      for(let k=2;k<=4;k++){
        ray.push(wrap(r+dr*k)*N + wrap(c+dc*k));
      }
      rays.push(ray);
    }
    ADJ.push(adj);RAYS.push(rays);
  }
})();

// Compute pulls for placing at cell (board unchanged). Returns [{from,to}, ...]
function pullsFor(board,cell){
  const out=[];
  for(let d=0;d<4;d++){
    const a=ADJ[cell][d];if(board[a]!==0)continue;
    const ray=RAYS[cell][d];
    for(let i=0;i<ray.length;i++){const s=ray[i];if(board[s]!==0){out.push({from:s,to:a});break;}}
  }
  return out;
}
// Apply placement + pulls in place. Returns pulls.
function applyMove(board,cell,player){
  board[cell]=player;
  const pulls=pullsFor(board,cell);
  for(const p of pulls){board[p.to]=board[p.from];board[p.from]=0;}
  return pulls;
}
// Sizes of orthogonally connected groups, sorted descending. Also fills labels if given.
const _seen=new Uint8Array(CELLS);const _stack=new Int8Array(CELLS);
function groupSizes(board,player,labels){
  _seen.fill(0);const sizes=[];
  for(let i=0;i<CELLS;i++){
    if(board[i]!==player||_seen[i])continue;
    let sz=0,sp=0;_stack[sp++]=i;_seen[i]=1;const gid=sizes.length;
    while(sp){
      const x=_stack[--sp]; sz++;
      if(labels)labels[x]=gid+1;
      const adj=ADJ[x]; // ADJ 배열에 이미 순환 룰(Torus)이 적용되어 있음
      for(let d=0;d<4;d++){
        const y=adj[d];
        if(board[y]===player&&!_seen[y]){_seen[y]=1;_stack[sp++]=y;}
      }
    }
    sizes.push(sz);
  }
  sizes.sort((a,b)=>b-a);
  return sizes;
}
// Winner when the game is over: compare group-size lists lexicographically; full tie -> WHITE (second player)
function finalWinner(board){
  const a=groupSizes(board,BLACK),b=groupSizes(board,WHITE);
  const n=Math.max(a.length,b.length);
  for(let i=0;i<n;i++){const x=a[i]||0,y=b[i]||0;if(x!==y)return x>y?BLACK:WHITE;}
  return WHITE; // 동점 시 후공 승리 (덤 역할)
}

/* ---------------- MCTS ---------------- */
let _rs=0x2545F491;
function rnd(){_rs^=_rs<<13;_rs>>>=0;_rs^=_rs>>>17;_rs^=_rs<<5;_rs>>>=0;return _rs/4294967296;}
const _emp=new Int8Array(CELLS);
function rollout(board,plies,toMove){ // random playout to the end; returns winner
  const b=board;let p=toMove;
  while(plies<MAX_PLIES){
    let n=0;for(let i=0;i<CELLS;i++)if(b[i]===0)_emp[n++]=i;
    const cell=_emp[(rnd()*n)|0];
    applyMove(b,cell,p);plies++;p=3-p;
  }
  return finalWinner(b);
}
function mctsChoose(board,plies,toMove,opts){
  const iters=opts.iters,timeMs=opts.timeMs;const start=Date.now();
  const root={board,plies,mover:3-toMove,n:0,w:0,children:null,result:0};
  const scratch=new Int8Array(CELLS);
  function expand(node){
    const p=3-node.mover;const kids=[];
    for(let i=0;i<CELLS;i++){if(node.board[i]!==0)continue;const nb=node.board.slice();applyMove(nb,i,p);
      const ch={board:nb,plies:node.plies+1,mover:p,move:i,n:0,w:0,children:null,result:0,parent:node};
      if(ch.plies>=MAX_PLIES)ch.result=finalWinner(nb);kids.push(ch);}
    node.children=kids;
  }
  let it=0;
  for(;it<iters;it++){
    if((it&63)===0&&Date.now()-start>timeMs)break;
    let node=root;
    while(node.children&&node.children.length&&!node.result){
      let best=null,bv=-1;const ln=Math.log(node.n+1);
      for(const ch of node.children){const v=ch.n===0?1e9+rnd():(ch.w/ch.n)+1.1*Math.sqrt(ln/ch.n);if(v>bv){bv=v;best=ch;}}
      node=best;
    }
    if(!node.result&&!node.children&&node.n>0)expand(node);
    if(node.children&&node.children.length&&!node.result)node=node.children[(rnd()*node.children.length)|0];
    let res;
    if(node.result)res=node.result;else{scratch.set(node.board);res=rollout(scratch,node.plies,3-node.mover);}
    for(let cur=node;cur;cur=cur.parent){cur.n++;if(res===cur.mover)cur.w++;}
  }
  if(!root.children)expand(root);
  const kids=root.children.slice().sort((a,b)=>b.n-a.n);
  let pick=kids[0];
  if(opts.topRandom&&kids.length>1){const k=Math.min(opts.topRandom,kids.length);pick=kids[(rnd()*k)|0];}
  return{move:pick.move,iters:it,winrate:pick.n?pick.w/pick.n:0.5,ms:Date.now()-start};
}
const LEVELS={
  easy:       {iters:150,     timeMs:1500, topRandom:3},
  normal:     {iters:3000,    timeMs:3000},
  hard:       {iters:80000,   timeMs:2500},
  impossible: {iters:500000,  timeMs:30000}, 
};

/* ---------------- game state ---------------- */
function newGame(){return{board:new Int8Array(CELLS),plies:0,toMove:BLACK,moves:[],result:null,stones:[],nextId:1};}
function playMove(game,cell){
  const player=game.toMove;
  const pulls=applyMove(game.board,cell,player);
  const rec={cell,player,pulls};
  for(const p of pulls){const st=game.stones.find(s=>s.cell===p.from);if(st)st.cell=p.to;}
  const stone={id:game.nextId++,cell,color:player};game.stones.push(stone);rec.stoneId=stone.id;
  game.moves.push(rec);game.plies++;game.toMove=3-player;
  if(game.plies>=MAX_PLIES)game.result={winner:finalWinner(game.board),black:groupSizes(game.board,BLACK),white:groupSizes(game.board,WHITE)};
  return rec;
}
function undoMove(game){
  const rec=game.moves.pop();if(!rec)return false;
  game.board[rec.cell]=0;
  for(let i=rec.pulls.length-1;i>=0;i--){const p=rec.pulls[i];game.board[p.from]=game.board[p.to];game.board[p.to]=0;const st=game.stones.find(s=>s.cell===p.to);if(st)st.cell=p.from;}
  const idx=game.stones.findIndex(s=>s.id===rec.stoneId);if(idx>=0)game.stones.splice(idx,1);
  game.plies--;game.toMove=rec.player;game.result=null;return true;
}
// Base36 encoding for robust infinite scale URL saving
function encodeMoves(moves){return moves.map(m=>m.cell.toString(36).padStart(2,'0')).join('');}
function decodeMoves(str){
  const out=[];
  for(let i=0;i<str.length;i+=2){
    const c=parseInt(str.substr(i,2),36);
    if(isNaN(c)||c<0||c>=CELLS)return null;
    out.push(c);
  }
  return out;
}

</script>
